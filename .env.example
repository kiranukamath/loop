# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── AWS / Bedrock ──────────────────────────────────────────────────────────
# Long-term Bedrock API key (bearer token).
# Find this in the AWS console under Bedrock > API keys.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here

# AWS region where your Bedrock model is enabled.
AWS_REGION=us-east-1

# Bedrock model ID.  Must be enabled in your account + region.
# Cross-region inference IDs (us.*) work across us-east-1 / us-west-2.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# ── Model provider (v1 = bedrock only) ────────────────────────────────────
MODEL_PROVIDER=bedrock

# ── Langfuse (optional — leave all empty to disable tracing) ─────────────
# Get these from your Langfuse project → Settings → API Keys.
# LANGFUSE_HOST should point to your self-hosted instance IP/port.
# All three must be set; leaving public or secret key empty disables tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://<langfuse-server-ip>:3000

# ── Phase 18 — production infra (all optional; empty = today's in-memory/
#    fixture/keyless defaults, unchanged) ─────────────────────────────────
# 18a: Postgres checkpointer + long-term store. Empty = MemorySaver/SqliteSaver
# (DB_PATH below) + InMemoryStore.
PG_CONN_STRING=

# 18b/18e: pgvector-backed question index + Postgres question-bank DAO
# (same database — questions/rubrics/reference_answers tables alongside the
# pgvector index). Empty = InMemoryVectorStore + fixtures/*.json.
PGVECTOR_CONN_STRING=

# 18c: set to switch loop/research/search.py from keyless DuckDuckGo to Tavily.
TAVILY_API_KEY=

# 18d: set MODEL_PROVIDER=ollama to route both chat + embeddings through a
# local/self-hosted Ollama server instead of Bedrock.
OLLAMA_MODEL_ID=llama3.1
OLLAMA_EMBED_MODEL_ID=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Path to the SQLite checkpoint file (ignored when PG_CONN_STRING is set).
DB_PATH=
