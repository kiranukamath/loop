# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── AWS / Bedrock ──────────────────────────────────────────────────────────
# Long-term Bedrock API key (bearer token).
# Find this in the AWS console under Bedrock > API keys.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here

# AWS region where your Bedrock model is enabled.
AWS_REGION=us-east-1

# Bedrock model ID.  Must be enabled in your account + region.
# Cross-region inference IDs (us.*) work across us-east-1 / us-west-2.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# ── Model provider (v1 = bedrock only) ────────────────────────────────────
MODEL_PROVIDER=bedrock

# ── Langfuse (optional — leave all empty to disable tracing) ─────────────
# Get these from your Langfuse project → Settings → API Keys.
# LANGFUSE_HOST should point to your self-hosted instance IP/port.
# All three must be set; leaving public or secret key empty disables tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://<langfuse-server-ip>:3000
